<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <!-- Content container -->
    <!--<androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4FB156"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="SchedulEasy"
        app:titleMarginStart="25dp"
        app:titleTextColor="@color/black"
        app:overflowIcon="@null"/>-->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4FB156"
        android:elevation="4dp"
        app:title="SchedulEasy"
        app:titleMarginStart="25dp"
        app:titleTextColor="@color/black" />  <!-- Now works! -->

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@+id/fabAddTimetable">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/timetableList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp" />

        <TextView
            android:id="@+id/tvUserMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Mode"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No timetables found\nTap + to create one"
            android:textColor="#757575"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Floating Action Button - aligned to bottom end of parent -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTimetable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/addbutnn"
        android:scaleType="centerInside"
        app:fabCustomSize="100dp"
        app:maxImageSize="70dp"
        android:visibility="visible"
        app:backgroundTint="#4FB156"
        app:elevation="8dp"
        app:tint="@null" />
</RelativeLayout>
